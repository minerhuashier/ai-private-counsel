{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Human Approval Record",
  "description": "A scoped approval for a high-risk action. The approval is not a digital signature.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approval_id",
    "action",
    "target_version",
    "scope",
    "status",
    "human_approved",
    "approved_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "approval_id": {
      "type": "string",
      "pattern": "^APR-[A-Z0-9-]{3,64}$"
    },
    "action": {
      "type": "string",
      "enum": [
        "court_submission",
        "signature",
        "payment",
        "complaint",
        "message_send",
        "public_post",
        "other_external_action"
      ]
    },
    "target_version": {
      "type": "string",
      "minLength": 1
    },
    "target_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "expired",
        "revoked"
      ]
    },
    "human_approved": {
      "type": "boolean"
    },
    "approved_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "approved"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "human_approved": {
            "const": true
          },
          "approved_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  ]
}

